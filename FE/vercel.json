{
  "buildCommand": "npm run build",
  "outputDirectory": "build/client",
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/(add-property|register|forgot-password|change-password|create-object)",
      "destination": "/__spa-fallback.html"
    },
    {
      "source": "/(en|ru)/(add-property|register|forgot-password|change-password|create-object)",
      "destination": "/__spa-fallback.html"
    },
    {
      "source": "/(preview-object|edit-object)/:id",
      "destination": "/__spa-fallback.html"
    },
    {
      "source": "/(en|ru)/(preview-object|edit-object)/:id",
      "destination": "/__spa-fallback.html"
    }
  ],
  "headers": [
    {
      "source": "/(add-property|register|forgot-password|change-password|create-object)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/(edit-object|preview-object)/:id",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/(en|ru)/(add-property|register|forgot-password|change-password|create-object)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/(en|ru)/(edit-object|preview-object)/:id",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/:path*.data",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/(built-objects|build-info).json",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    }
  ]
}
